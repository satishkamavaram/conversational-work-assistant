# Core A2A server settings
A2A_HOST=0.0.0.0
A2A_PORT=8082
A2A_PUBLIC_BASE_URL=http://localhost:8082
FRONTEND_ORIGIN=http://localhost:3000

# Strands + LiteLLM/OpenAI + MCP settings
OPENAI_API_KEY=your-openai-api-key
STRANDS_MODEL_ID=openai/gpt-5-mini
MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# Logging verbosity. INFO already logs raw (bytes-redacted) A2A request,
# stream, and response payloads. Set to DEBUG for additional low-level trace.
A2A_LOG_LEVEL=INFO
